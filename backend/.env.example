# ---------------------------------------------------------------------------
# Tender Monitor — environment configuration
# Copy to `.env` and adjust. Never commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Runtime ---
ENV=dev                     # dev | test | prod  (prod => JSON logs)
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tender_monitor

# --- Auth / JWT ---
JWT_SECRET=change-me        # REQUIRED in prod; use a long random string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- SMTP (email notifications; deferred feature — safe to leave as-is for now) ---
SMTP_HOST=localhost         # MailHog default in local dev
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@tender-monitor.bf
SMTP_USE_TLS=false

# --- Scraping ---
SCRAPE_DAILY_CAP_PER_DOMAIN=200
RATE_LIMIT_MIN_DELAY_MS=3000
RATE_LIMIT_MAX_DELAY_MS=8000
PLAYWRIGHT_HEADLESS=true

# --- CAPTCHA (deferred; keep disabled until Tier 3 lands) ---
CAPTCHA_ENABLED=false
CAPTCHA_API_KEY=
CAPTCHA_MAX_COST_PER_RUN=1.0

# --- Localization (target region: Burkina Faso) ---
SCRAPE_TIMEZONE=Africa/Ouagadougou
SCRAPE_LOCALE=fr-FR

# --- Limits ---
KEYWORDS_MAX_PER_USER=50
NOTIFICATION_EMAILS_MAX=5
