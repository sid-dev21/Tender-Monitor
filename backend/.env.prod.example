# ---------------------------------------------------------------------------
# Production environment — copy to backend/.env.prod on the VPS and fill in.
# Never commit backend/.env.prod (gitignored).
#
# MONGO_URI / SMTP_HOST / SMTP_PORT / OLLAMA_HOST are overridden by
# docker-compose.prod.yml's `environment:` block (service-name addressing) —
# left here only so the same file works if you ever run the backend outside
# compose. Everything else below is read as-is.
# ---------------------------------------------------------------------------

ENV=prod
LOG_LEVEL=INFO

# --- MongoDB (overridden to mongodb://mongo:27017 by compose) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tender_monitor

# --- Auth / JWT — REQUIRED: generate with `openssl rand -hex 32` ---
JWT_SECRET=REPLACE_ME_WITH_A_REAL_RANDOM_SECRET

# --- CORS — must be valid JSON, exact origin(s) of your Vercel deployment ---
# Example: CORS_ORIGINS=["https://tender-monitor.vercel.app"]
CORS_ORIGINS=["https://REPLACE_ME.vercel.app"]

# --- Frontend public URL — used to build the password-reset link in emails.
# Same Vercel URL as above (no trailing slash), NOT the API domain.
FRONTEND_BASE_URL=https://REPLACE_ME.vercel.app

# --- SMTP (MailHog for the exam demo — see docker-compose.prod.yml comment) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@tender-monitor.bf
SMTP_USE_TLS=false

# --- Scraping — capped low so a live demo scrape stays fast ---
MAX_PDFS_PER_RUN=5
SCRAPE_DAILY_CAP_PER_DOMAIN=200
RATE_LIMIT_MIN_DELAY_MS=3000
RATE_LIMIT_MAX_DELAY_MS=8000
PLAYWRIGHT_HEADLESS=true

# --- LLM relevance scoring (Ollama) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_S=60
SCORE_MAX_TENDERS=4

# --- Localization ---
SCRAPE_TIMEZONE=Africa/Ouagadougou
SCRAPE_LOCALE=fr-FR

# --- Limits ---
KEYWORDS_MAX_PER_USER=50
NOTIFICATION_EMAILS_MAX=5
